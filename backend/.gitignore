# --- Database files ---
# Add your specific database file names/extensions if they are different
*.db
*.sqlite
*.sqlite3
# If 'db' is a directory containing your SQLite file:
# db/*.sqlite3
# db/*.db
# If 'db' is a directory ONLY for a local dev database file, you can ignore the whole dir:
# db/
# CAUTION: If 'db/' contains migration scripts (e.g., Alembic), DO NOT ignore the 'db/' directory itself.
# Instead, ignore the specific database file within it, e.g., db/dev.sqlite3

